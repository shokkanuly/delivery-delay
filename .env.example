# Copy to .env for docker-compose. Local dev needs neither file:
# DATABASE_URL defaults to SQLite and API_URL defaults to localhost.

# Inside docker-compose, Postgres is reachable at host "db".
DATABASE_URL=postgresql+psycopg://sitepulse:sitepulse@db:5432/sitepulse

# Dashboard -> API base URL. Inside compose the API service is "api".
API_URL=http://api:8000

# Admin key for POST /train and POST /outcomes (sent as X-API-Key). The API and
# the dashboard server both read it; the browser never sees it. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SITEPULSE_ADMIN_KEY=change-me
