# Copy to .env for docker-compose. Local dev needs neither file:
# DATABASE_URL defaults to SQLite and API_URL defaults to localhost.

# Inside docker-compose, Postgres is reachable at host "db".
DATABASE_URL=postgresql+psycopg://bigroup:bigroup@db:5432/deliverydb

# Dashboard -> API base URL. Inside compose the API service is "api".
API_URL=http://api:8000
