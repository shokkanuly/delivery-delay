# Copy to .env.customer; never use these placeholders in production.
SITEPULSE_DOMAIN=receiving.example.kz
POSTGRES_PASSWORD=replace-with-a-unique-random-password
# URL-encode special characters in the password component.
DATABASE_URL=postgresql+psycopg://sitepulse:replace-with-a-unique-random-password@db:5432/sitepulse
SITEPULSE_ADMIN_KEY=replace-with-a-unique-random-operator-key
